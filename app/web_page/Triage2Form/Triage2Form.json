    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.paciente ){",
        "\treturn {",
        "\t\t//map paciente variable to expected task contract input",
        "\t\tpacienteInput: {",
        "\t\t\tsintomas: $data.paciente.sintomas !== undefined ? $data.paciente.sintomas : null,",
        "\t\t\ttriageOpciones: $data.paciente.triageOpciones !== undefined ? $data.paciente.triageOpciones : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },

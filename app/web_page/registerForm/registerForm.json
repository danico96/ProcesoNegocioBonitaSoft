  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "paciente" : {
      "type" : "url",
      "value" : [
        "../{{context.paciente_ref.link}}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.paciente ){",
        "\treturn {",
        "\t\t//map paciente variable to expected task contract input",
        "\t\tpacienteInput: {",
        "\t\t\tfecha: $data.paciente.fecha !== undefined ? $data.paciente.fecha : null,",
        "\t\t\tnombrePaciente: $data.paciente.nombrePaciente !== undefined ? $data.paciente.nombrePaciente : null,",
        "\t\t\tidentificacionPaciente: $data.paciente.identificacionPaciente !== undefined ? $data.paciente.identificacionPaciente : null,",
        "\t\t\tedadPaciente: $data.paciente.edadPaciente !== undefined ? $data.paciente.edadPaciente : null,",
        "\t\t\tdireccionPaciente: $data.paciente.direccionPaciente !== undefined ? $data.paciente.direccionPaciente : null,",
        "\t\t\temailPaciente: $data.paciente.emailPaciente !== undefined ? $data.paciente.emailPaciente : null,",
        "\t\t\tpacienteCritico: $data.paciente.pacienteCritico !== undefined ? $data.paciente.pacienteCritico : null",
        "\t\t}",
        "\t}",
        "}"
      ],

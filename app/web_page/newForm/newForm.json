    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.paciente ){",
        "\treturn {",
        "\t\t//map paciente variable to expected task contract input",
        "\t\tpacienteInput: {",
        "\t\t\tnombrePaciente: $data.paciente.nombrePaciente !== undefined ? $data.paciente.nombrePaciente : null,",
        "\t\t\tcirugia: $data.paciente.cirugia !== undefined ? $data.paciente.cirugia : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
